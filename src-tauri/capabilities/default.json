{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-open-path",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "dialog:allow-open",
    "notification:default"
  ]
}